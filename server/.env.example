# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medipredict

# Security
# Minimum 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Allowed frontend origin (used for CORS when NOT going through the Vite proxy)
CLIENT_ORIGIN=http://localhost:5173

# Directory where uploaded medical report files are stored.
# Defaults to <server>/uploads (created automatically).
# UPLOAD_DIR=